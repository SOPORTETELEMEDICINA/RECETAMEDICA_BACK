             x:Class="RMD.Movil.Pages.SplashPage"
             NavigationPage.HasBackButton="False" 
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="splash.png" Padding="0">


    <!-- Solo la barra encima -->

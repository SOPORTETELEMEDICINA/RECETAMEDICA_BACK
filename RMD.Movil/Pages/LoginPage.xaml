<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:RMD.Movil.PageModels"
    xmlns:converters="clr-namespace:RMD.Movil.Utilities.Converters"
    x:Class="RMD.Movil.Pages.LoginPage"
    x:DataType="viewmodels:LoginPageModel"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="Transparent"
    BackgroundImageSource="background_gradient.png">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:PasswordIconConverter x:Key="PasswordIconConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Root grid con layout controlado -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Logo y título -->
        <VerticalStackLayout Grid.Row="0" Padding="0,40,0,10" Spacing="5" HorizontalOptions="Center">
            <Image x:Name="LogoImage"
                   Source="logo_mid.png"
                   HeightRequest="120"
                   Aspect="AspectFit"/>
            <Label Text="Receta Médica Digital" 
                   FontSize="18"
                   TextColor="#00b7bd"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Scroll solo para contenido central -->
        
            <VerticalStackLayout Grid.Row="1"
                                 Padding="30,0" Spacing="20" HorizontalOptions="Center">

                <!-- Tarjeta de login -->
                <Border x:Name="ContenedorLogin"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 50"
                        BackgroundColor="Transparent"
                        WidthRequest="320"
                        Padding="0">

                    <Grid BackgroundColor="Transparent">

                        <!-- Fondo decorativo -->
                        <Image Source="fondo_login.png"
                               Aspect="AspectFill"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"
                               ZIndex="0" />

                        <!-- Contenido de login -->
                        <Grid RowDefinitions="Auto,*"
                              Padding="25"
                              ZIndex="1">

                            <!-- Usuario / Contraseña / Botón -->
                            <VerticalStackLayout Spacing="20">

                                <!-- Usuario -->
                                <Border x:Name="UsuarioLayout"
                                        Stroke="Transparent"
                                        BackgroundColor="White"
                                        StrokeShape="RoundRectangle 30"
                                        Padding="0"
                                        HeightRequest="45">
                                    <Grid ColumnDefinitions="40,*">
                                        <Image Source="icon_user.png"
                                               WidthRequest="20"
                                               HeightRequest="20"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"/>
                                        <Entry Grid.Column="1"
                                               Placeholder="Usuario o Email"
                                               FontSize="16"
                                               TextColor="Black"
                                               PlaceholderColor="#47c7f1"
                                               BackgroundColor="Transparent"
                                               Text="{Binding Usuario}" />
                                    </Grid>
                                </Border>

                                <!-- Contraseña -->
                                <Border x:Name="PasswordLayout"
                                        Stroke="Transparent"
                                        BackgroundColor="White"
                                        StrokeShape="RoundRectangle 30"
                                        Padding="0"
                                        HeightRequest="45">
                                    <Grid ColumnDefinitions="40,*,Auto">
                                        <Image Source="icon_lock.png"
                                               WidthRequest="20"
                                               HeightRequest="20"
                                               Background="Transparent"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"/>
                                        <Entry Grid.Column="1"
                                               Placeholder="Contraseña"
                                               Text="{Binding Password}"
                                               IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolConverter}}"
                                               FontSize="16"
                                               TextColor="Black"
                                               PlaceholderColor="#47c7f1"
                                               BackgroundColor="Transparent" />
                                        <Label  Grid.Column="2"
                                                Text="{Binding IsPasswordVisible, Converter={StaticResource PasswordIconConverter}}"
                                                FontFamily="FASolid"
                                                FontSize="20"
                                                VerticalOptions="Center"
                                                HorizontalOptions="End"
                                                Margin="10,0,0,0"
                                                TextColor="Gray">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding TogglePasswordCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </Border>

                                <!-- Botón ingresar -->
                                <Button x:Name="IngresarBtn"
                                        Text="Ingresar"
                                        Command="{Binding LoginCommand}"
                                        BackgroundColor="#00b7bd"
                                        TextColor="White"
                                        CornerRadius="25"
                                        HeightRequest="45"
                                        FontSize="16"
                                        WidthRequest="200"
                                        HorizontalOptions="Center"
                                        Margin="0,5,0,0" />

                            </VerticalStackLayout>

                            <!-- Parte inferior -->
                            <VerticalStackLayout Grid.Row="1"
                                                 Spacing="15"
                                                 VerticalOptions="Center"
>
                                <Button x:Name="LblOlvido"
                                        CornerRadius="10"
                                        Text="¿Olvidaste tu contraseña?"
                                        BackgroundColor="#47c7f1"
                                        TextColor="White"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Margin="0,15,0,0"
                                        VerticalOptions="End"
                                        HeightRequest="40"
                                        HorizontalOptions="Center">
                                    <Button.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                                    </Button.GestureRecognizers>
                                </Button>

                                <Label x:Name="LblInferior"
                                       Text="Por Consulta en Línea"
                                       TextColor="Black"
                                       FontSize="14"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>

                        </Grid>
                    </Grid>
                </Border>

            </VerticalStackLayout>
    </Grid>
</ContentPage>



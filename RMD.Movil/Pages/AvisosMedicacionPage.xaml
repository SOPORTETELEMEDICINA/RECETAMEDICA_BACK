<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RMD.Movil.Pages.Controls"
    xmlns:pageModels="clr-namespace:RMD.Movil.PageModels"
    xmlns:alerta="clr-namespace:RMD.Shared.Models.Receta.AlertaToma.Response;assembly=RMD.Shared.Models"
    xmlns:local="clr-namespace:RMD.Movil.Pages"
    x:Class="RMD.Movil.Pages.AvisosMedicacionPage"
    x:DataType="pageModels:AvisosMedicacionPageModel"
    x:Name="ThisPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundImageSource="fondo_pantalla.png">

    <ContentPage.Resources>
        <Color x:Key="CalText">#1F2937</Color>
        <Color x:Key="CalTextMuted">#6B7280</Color>
        <Color x:Key="PillSelected">#6F61EE</Color>
        <Color x:Key="PillToday">#EDE9FE</Color>

        <local:GuidToColorConverter x:Key="GuidToColor"/>

        <Style x:Key="CalMonthTitle" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{StaticResource CalText}"/>
        </Style>
        <Style x:Key="CalDayName" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextColor" Value="{StaticResource CalTextMuted}"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CalDayNumber" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextColor" Value="{StaticResource CalText}"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- HEADER -->
        <controls:UserInfoComponent Grid.Row="0" Margin="20,30,20,0" />

        <!-- CALENDARIO: HOY + 6 DÍAS -->
        <Border Grid.Row="1" StrokeShape="RoundRectangle 20" Margin="10,20" StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#EEF2F7" Offset="0.0" />
                    <GradientStop Color="#B7CDE6" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Padding="0" RowDefinitions="Auto,Auto">
                <Label Grid.Row="0"
                       Text="{Binding MesSemana}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#1F2937"
                       Margin="0,0,0,8"/>

                <CollectionView Grid.Row="1"
                                HeightRequest="104"
                                Margin="0,10,0,0"
                                ItemsSource="{Binding Semana}"
                                SelectionMode="None"
                                BackgroundColor="Transparent"
                                HorizontalScrollBarVisibility="Never"
                                VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="7"
                                         HorizontalItemSpacing="4" VerticalItemSpacing="0" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="pageModels:DiaSemanaItem">
                            <Grid HorizontalOptions="Fill" VerticalOptions="Center" Padding="0">

                                <!-- PÍLDORA -->
                                <Border StrokeShape="RoundRectangle 26"
                                        Padding="10,10"
                                        HeightRequest="78"
                                        HorizontalOptions="Center"
                                        Background="Transparent"
                                        InputTransparent="False">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDayTapped" />
                                    </Border.GestureRecognizers>

                                    <!-- Reglas de color -->
                                    <Border.Triggers>
                                        <MultiTrigger TargetType="Border">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsToday}" Value="True"/>
                                                <BindingCondition Binding="{Binding IsSelected}" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="{StaticResource PillToday}"/>
                                        </MultiTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PillSelected}"/>
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <!-- Contenido con alturas fijas -->
                                    <Grid RowDefinitions="18,26" RowSpacing="4" Padding="0" VerticalOptions="Center">
                                        <Label Grid.Row="0"
                                               Text="{Binding DayName}"
                                               FontSize="12"
                                               HeightRequest="18"
                                               VerticalTextAlignment="Center"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="NoWrap"
                                               MaxLines="1"
                                               TextColor="#7B8794">
                                            <Label.Triggers>
                                                <MultiTrigger TargetType="Label">
                                                    <MultiTrigger.Conditions>
                                                        <BindingCondition Binding="{Binding IsToday}" Value="True"/>
                                                        <BindingCondition Binding="{Binding IsSelected}" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter Property="TextColor" Value="#6F61EE"/>
                                                    <Setter Property="FontAttributes" Value="Bold"/>
                                                </MultiTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White"/>
                                                    <Setter Property="FontAttributes" Value="Bold"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Label Grid.Row="1"
                                               Text="{Binding DayNumber}"
                                               FontSize="10"
                                               HeightRequest="26"
                                               VerticalTextAlignment="Center"
                                               HorizontalTextAlignment="Center"
                                               TextColor="#1F2937">
                                            <Label.Triggers>
                                                <MultiTrigger TargetType="Label">
                                                    <MultiTrigger.Conditions>
                                                        <BindingCondition Binding="{Binding IsToday}" Value="True"/>
                                                        <BindingCondition Binding="{Binding IsSelected}" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter Property="TextColor" Value="#6F61EE"/>
                                                    <Setter Property="FontAttributes" Value="Bold"/>
                                                </MultiTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White"/>
                                                    <Setter Property="FontAttributes" Value="Bold"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- LISTA DE MEDICAMENTOS con PULL-TO-REFRESH -->
        <RefreshView Grid.Row="2"
                     Command="{Binding ReloadCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Medicamentos}" Margin="20,0" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="alerta:AlertaProgramadaResponse">
                        <Grid Margin="0,15" HeightRequest="130">

                            <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" Margin="10,25,10,0" Padding="15">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F8F9FA" Offset="0.0" />
                                        <GradientStop Color="#E5E7EB" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Margin="0,20,0,0">
                                    <Label Text="{Binding Medicamento}" FontSize="14" FontAttributes="Bold" TextColor="#3A3A3A" HorizontalOptions="Center" />
                                    <Label Text="{Binding FechaToma, StringFormat='{0:hh:mm tt}'}" FontSize="12" TextColor="#3A3A3A" HorizontalOptions="Center" />
                                    <Label Text="{Binding Observaciones}" FontSize="12" TextColor="#3A3A3A" HorizontalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Observaciones}" Value="">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Observaciones}" Value="{x:Null}">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Ícono redondo (tap aquí para mostrar el modal y desactivar) -->
                            <Border WidthRequest="50" HeightRequest="50"
                                    StrokeShape="RoundRectangle 25" StrokeThickness="0"
                                    BackgroundColor="White" Padding="8"
                                    HorizontalOptions="Center" VerticalOptions="Start"
                                    InputTransparent="False"
                                    ZIndex="10">
                                <Border.GestureRecognizers>
                                    <!-- Command hacia el VM -->
                                    <TapGestureRecognizer
                                        Command="{Binding Path=BindingContext.ToggleAlertaCommand, Source={x:Reference ThisPage}}"
                                        CommandParameter="{Binding .}" />
                                    <!-- Fallback por evento si el binding fallara -->
                                    <TapGestureRecognizer Tapped="OnIconTapped" />
                                </Border.GestureRecognizers>

                                <Image Aspect="AspectFit" HeightRequest="30" WidthRequest="30">
                                    <Image.Source>
                                        <FontImageSource FontFamily="FASolid"
                                                         Glyph="&#xf484;"
                                                         Size="24"
                                                         Color="{Binding IdAlerta, Converter={StaticResource GuidToColor}}"/>
                                    </Image.Source>
                                </Image>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- BOTÓN -->
        <Button Grid.Row="3" Text="AGREGAR MEDICAMENTO MANUAL"
                BackgroundColor="#ed8a60" TextColor="White" FontAttributes="Bold"
                CornerRadius="20" HeightRequest="50" Margin="20,10"
                HorizontalOptions="Fill"
                Command="{Binding AbrirAlertaManualCommand}" />

        <!-- FOOTER -->
        <controls:BottomNavBar Grid.Row="4" />
    </Grid>
</ContentPage>

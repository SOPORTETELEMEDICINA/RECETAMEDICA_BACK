<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RMD.Movil.Pages.Controls"
    xmlns:pageModels="clr-namespace:RMD.Movil.PageModels"
    xmlns:alerta="clr-namespace:RMD.Shared.Models.Receta.AlertaToma.Response;assembly=RMD.Shared.Models"
    x:Class="RMD.Movil.Pages.AvisosMedicacionPage"
    x:DataType="pageModels:AvisosMedicacionPageModel"
    NavigationPage.HasNavigationBar="False"
    BackgroundImageSource="fondo_pantalla.png">

    <ContentPage.Resources>
        <Color x:Key="CalText">#1F2937</Color>
        <Color x:Key="CalTextMuted">#6B7280</Color>
        <Color x:Key="CalPill">#6F61EE</Color>

        <Style x:Key="CalMonthTitle" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{StaticResource CalText}"/>
        </Style>
        <Style x:Key="CalDayName" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextColor" Value="{StaticResource CalTextMuted}"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CalDayNumber" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextColor" Value="{StaticResource CalText}"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
        </Style>
    </ContentPage.Resources>

    <!-- 5 filas: Header, Calendario, Lista, Botón, Footer -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- HEADER -->
        <controls:UserInfoComponent Grid.Row="0" Margin="20,30,20,0" />

        <!-- ===== CALENDARIO (HOY + 6 días, NO seleccionable) ===== -->
        <Border Grid.Row="1"
        StrokeShape="RoundRectangle 20"
        Margin="20,10"
        StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#EEF2F7" Offset="0.0" />
                    <GradientStop Color="#B7CDE6" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <!-- Estilos locales del calendario -->
            <Border.Resources>
                <!-- Evita que estilos globales pinten fondos -->
                <Style TargetType="Border">
                    <Setter Property="BackgroundColor" Value="Transparent"/>
                    <Setter Property="StrokeThickness" Value="0"/>
                </Style>

                <Color x:Key="CalText">#1F2937</Color>
                <Color x:Key="CalMuted">#7B8794</Color>
                <Color x:Key="Pill">#6F61EE</Color>

                <!-- Píldora vertical que envuelve NOMBRE + NÚMERO -->
                <Style x:Key="PillBorder" TargetType="Border">
                    <!-- Alto y forma alargada como el mock -->
                    <Setter Property="Padding" Value="12,10"/>
                    <Setter Property="WidthRequest" Value="46"/>
                    <Setter Property="HeightRequest" Value="64"/>
                    <Setter Property="HorizontalOptions" Value="Center"/>
                    <Setter Property="VerticalOptions" Value="Center"/>
                    <Setter Property="StrokeShape" Value="RoundRectangle 24"/>
                    <Setter Property="BackgroundColor" Value="Transparent"/>
                </Style>

                <!-- NOMBRE del día (arriba, pequeño) -->
                <Style x:Key="DayNameLabel" TargetType="Label">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontAttributes" Value="None"/>
                    <Setter Property="HorizontalTextAlignment" Value="Center"/>
                    <Setter Property="TextColor" Value="{StaticResource CalMuted}"/>
                </Style>

                <!-- NÚMERO del día (abajo) -->
                <Style x:Key="DayNumberLabel" TargetType="Label">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontAttributes" Value="None"/>
                    <Setter Property="HorizontalTextAlignment" Value="Center"/>
                    <Setter Property="TextColor" Value="{StaticResource CalText}"/>
                </Style>
            </Border.Resources>

            <Grid Padding="16" RowDefinitions="Auto,Auto">

                <!-- Mes, Año -->
                <Label Grid.Row="0"
               Text="{Binding MesSemana}"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="#1F2937"
               Margin="0,0,0,8"/>

                <!-- 7 días en una sola fila: número grande, cápsula alta y más abajo -->
                <CollectionView Grid.Row="1"
                HeightRequest="104"
                Margin="0,18,0,6"          
                    ItemsSource="{Binding Semana}"
                SelectionMode="None"
                BackgroundColor="Transparent"
                HorizontalScrollBarVisibility="Never"
                VerticalScrollBarVisibility="Never">

                    <CollectionView.ItemsLayout>
                        <!-- 7 columnas exactas para que siempre quepan -->
                        <GridItemsLayout Orientation="Vertical"
                         Span="7"
                         HorizontalItemSpacing="4"
                         VerticalItemSpacing="0" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="pageModels:DiaSemanaItem">
                            <Grid HorizontalOptions="Fill"
                  VerticalOptions="Center"
                  Padding="0">

                                <!-- Píldora más ALTA y un poquito más ancha -->
                                <Border StrokeShape="RoundRectangle 26"
                        BackgroundColor="Transparent"
                        Padding="14,16"         
                                    HeightRequest="78"
                        HorizontalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#6F61EE"/>
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <VerticalStackLayout Spacing="4" Padding="0" VerticalOptions="Center">
                                        <!-- NOMBRE (ligeramente más abajo por el padding de la cápsula) -->
                                        <Label Text="{Binding DayName}"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="#7B8794">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="TextColor" Value="White"/>
                                                    <Setter Property="FontAttributes" Value="Bold"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <!-- NÚMERO MÁS GRANDE -->
                                        <Label Text="{Binding DayNumber}"
                               FontSize="20"    
                                            HorizontalTextAlignment="Center"
                               TextColor="#1F2937">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="TextColor" Value="White"/>
                                                    <Setter Property="FontAttributes" Value="Bold"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>



            </Grid>
        </Border>
        <!-- ===== FIN CALENDARIO ===== -->


        <!-- LISTA DE MEDICAMENTOS -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Medicamentos}"
                        Margin="20,0"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="alerta:AlertaProgramadaResponse">
                    <Grid Margin="0,15" HeightRequest="130">
                        <Border StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                Margin="10,25,10,0"
                                Padding="15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F8F9FA" Offset="0.0" />
                                    <GradientStop Color="#E5E7EB" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>

                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Margin="0,20,0,0">
                                <Label Text="{Binding Nombre}" FontSize="14" FontAttributes="Bold" TextColor="#3A3A3A" HorizontalOptions="Center"/>
                                <Label Text="{Binding Hora}"   FontSize="12" TextColor="#3A3A3A" HorizontalOptions="Center"/>
                                <Label Text="{Binding Periodo}" FontSize="12" TextColor="#3A3A3A" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Icono flotante -->
                        <Border WidthRequest="50" HeightRequest="50"
                                StrokeShape="RoundRectangle 25" StrokeThickness="0"
                                BackgroundColor="White" Padding="8"
                                HorizontalOptions="Center" VerticalOptions="Start">
                            <Image Aspect="AspectFit" HeightRequest="30" WidthRequest="30">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding TipoMedicamento}" Value="Liquido">
                                        <Setter Property="Source" Value="icon_medicamento_liquido.png" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Image" Binding="{Binding TipoMedicamento}" Value="Solido">
                                        <Setter Property="Source" Value="icon_medicamento_solido.png" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- BOTÓN AGREGAR -->
        <Button Grid.Row="3"
                Text="AGREGAR MEDICAMENTO MANUAL"
                BackgroundColor="#ed8a60"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="20"
                HeightRequest="50"
                Margin="20,10"
                HorizontalOptions="FillAndExpand" />

        <!-- FOOTER -->
        <controls:BottomNavBar Grid.Row="4" />
    </Grid>
</ContentPage>

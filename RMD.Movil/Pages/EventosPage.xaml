<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:RMD.Movil.PageModels"
             xmlns:controls="clr-namespace:RMD.Movil.Pages.Controls"
             xmlns:response="clr-namespace:RMD.Shared.Models.Pacientes.Response;assembly=RMD.Shared.Models"
             xmlns:models="clr-namespace:RMD.Movil.Models"
             x:Class="RMD.Movil.Pages.EventosPage"
             x:DataType="pageModels:EventosPageModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="fondo_pantalla.png">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- HEADER GLOBAL DEL USUARIO -->
        <controls:UserInfoComponent Grid.Row="0" Margin="20,30,20,0"/>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1" RowDefinitions="Auto" Padding="10" RowSpacing="15">
            <!-- BOTÓN REGISTRAR NUEVO -->
            <Border Grid.Row="0"
                    StrokeThickness="0"
                    Background="#6f61ee"
                    StrokeShape="RoundRectangle 20"
                    Padding="15">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RegistrarNuevoCommand}" />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="6" HorizontalOptions="Start">
                    <Border WidthRequest="36"
                            HeightRequest="36"
                            StrokeThickness="0"
                            Background ="White"
                            StrokeShape="RoundRectangle 18"
                            Padding="4"
                            HorizontalOptions="StartAndExpand">
                        <Image Source="icon_footer_beneficios_active" Aspect="AspectFit"/>
                    </Border>

                    <Label Text="Registrar Nuevo"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Start"/>
                    <Label Text="EVENTO"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Start"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Grid Grid.Row="2" 
              Margin="0,0,0,10" 
              RowDefinitions="Auto,*" 
              Padding="0" 
              RowSpacing="15">

            <Border Grid.Row="2"
                    StrokeThickness="0"
                    Background ="White"
                    StrokeShape="RoundRectangle 20"
                    Margin="5,0"
                    Padding="5"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.2" />
                </Border.Shadow>

                <!-- Contenedor de contenido dividido por filas -->
                <Grid RowDefinitions="Auto, *"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">

                    <!-- Título -->
                    <StackLayout Grid.Row="0" Spacing="2" HorizontalOptions="Center">
                        <Label Text="Historial de Eventos"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#9d93f3"
                               HorizontalOptions="Center"/>
                        <BoxView HeightRequest="2"
                                 Color="#9d93f3"
                                 WidthRequest="150"
                                 HorizontalOptions="Center"/>
                    </StackLayout>

                    <!-- Lista scrolleable -->
                    <CollectionView Grid.Row="1"
                             ItemsSource="{Binding Eventos}"
                             Margin="0,10,0,0"
                             VerticalOptions="Fill"
                             HorizontalOptions="Fill">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:EventosSaludModel">
                                <Border Stroke="#e0e0e0"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 15"
                                        Background="White"
                                        Padding="15"
                                        Margin="0,5">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="{Binding Descripcion}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#3A3A3A"/>
                                        <BoxView HeightRequest="1"
                                                 Color="#e0e0e0"
                                                 Margin="0,2,0,0"/>

                                        <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,0">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="5">

                                                <Label Text="Fecha:"
                                                       FontSize="14"
                                                       TextColor="#69728b"/>
                                                <Label Text="{Binding Fecha, StringFormat='{0:yyyy-MM-dd}'}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#9d93f3"/>
                                            </HorizontalStackLayout>

                                            <Border Grid.Column="1"
                                                    Background = "{Binding ColorEvento}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 15"
                                                    Padding="8,3"
                                                    HorizontalOptions="End">
                                                <Label Text="{Binding NombreEvento, FallbackValue='(sin nombre)'}"
                                                       FontSize="12"
                                                       TextColor="Black"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="End"/>
                                            </Border>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>



        </Grid>

        <!-- FOOTER GLOBAL -->
        <controls:BottomNavBar Grid.Row="3" />
    </Grid>
</ContentPage>

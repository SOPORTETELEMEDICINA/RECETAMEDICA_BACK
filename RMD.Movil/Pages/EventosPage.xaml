<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:RMD.Movil.PageModels"
             xmlns:controls="clr-namespace:RMD.Movil.Pages.Controls"
             xmlns:models="clr-namespace:RMD.Shared.Models.Pacientes;assembly=RMD.Shared.Models"
             xmlns:response="clr-namespace:RMD.Shared.Models.Pacientes.Response;assembly=RMD.Shared.Models"
             x:Class="RMD.Movil.Pages.EventosPage"
             x:DataType="pageModels:EventosPageModel"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Fondo general -->
        <Image Source="Shared/fondo_plantilla.png"
               Aspect="AspectFill"
               Grid.RowSpan="3"
               Opacity="1" />

        <!-- Header con info del usuario -->
        <controls:HeaderPage Grid.Row="0" Margin="0,30,0,0" />

        <Border  Grid.Row="1"
                 BackgroundColor="#6F61EE"
                 StrokeThickness="0"
                 Stroke="#6F61EE"
                 StrokeShape="RoundRectangle 18"
                 Padding="1"
                 Margin="0">

            <Border.Shadow>
                <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.2" />
            </Border.Shadow>

            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding RegistrarNuevoCommand}" />
            </Border.GestureRecognizers>

            <!-- Contenido de la "card" -->
            <VerticalStackLayout Spacing="20"
                                 BackgroundColor="#6F61EE"
                                 Padding="8"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Center">
                <!-- Imagen ícono -->
                <Image Source="Images/EventosSalud/icono_evento.png"
                       WidthRequest="36"
                       HeightRequest="36"
                       Aspect="Fill"
                       HorizontalOptions="Start" />
                <!-- Texto -->
                <Label Text="Registrar Nuevo"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Fill" />
                <Label Text="Evento"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </Border>

        <!-- Historial de Eventos -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 20"
                Margin="5,0"
                Padding="5"
                HorizontalOptions="Fill">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.2" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="20">
                <Grid Padding="0" HeightRequest="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BackgroundColor="#EEE5FD"
                            StrokeShape="RoundRectangle 20"
                            Padding="15,5"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Label Text="Historial de Eventos"
                               FontSize="16"
                               TextColor="#6D28D9"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>
                </Grid>

                <CollectionView ItemsSource="{Binding Eventos}"
                                HeightRequest="400">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="response:EventosSaludResponse">
                            <Border Stroke="LightGray"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="16"
                                    Margin="10,5"
                                    BackgroundColor="White">

                                <VerticalStackLayout Spacing="10">

                                    <!-- Fila 1: Descripción -->
                                    <Label Text="{Binding Descripcion}"
                                           FontSize="14"
                                           TextColor="#4A4A4A"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap" />

                                    <!-- Línea divisoria -->
                                    <BoxView HeightRequest="1"
                                             BackgroundColor="#DDDDDD"
                                             HorizontalOptions="Fill" />

                                    <!-- Fila 2: Fecha y etiqueta -->
                                    <Grid ColumnDefinitions="Auto,*"
                                          HorizontalOptions="Fill">

                                        <!-- Fecha -->
                                        <HorizontalStackLayout Grid.Column="0"
                                                               Spacing="4"
                                                               VerticalOptions="Center">
                                            <Label Text="Fecha:"
                                                   FontSize="14"
                                                   TextColor="Black"
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding Fecha, StringFormat='{0:yyyy-MM-dd}'}"
                                                   FontSize="14"
                                                   TextColor="#7C5CF0"
                                                   FontAttributes="Bold" />
                                        </HorizontalStackLayout>

                                        <!-- Etiqueta (tag ovalada) -->
                                        <Grid Grid.Column="1"
                                              WidthRequest="128"
                                              HeightRequest="28"
                                              HorizontalOptions="End"
                                              VerticalOptions="Center">

                                            <Image Source="boton_fondo_ovalado.png"
                                                   Aspect="Fill"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill" />

                                            <Label Text="{Binding NombreEvento}"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>
        <!-- Barra de navegación inferior -->
        <controls:BottomNavBar Grid.Row="3" />
    </Grid>
</ContentPage>

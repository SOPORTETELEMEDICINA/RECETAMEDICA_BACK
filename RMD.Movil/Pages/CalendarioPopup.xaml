<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="RMD.Movil.Pages.CalendarioPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="16">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EEF2F7" Offset="0.0" />
                <GradientStop Color="#B7CDE6" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid RowDefinitions="Auto,Auto">
            <!-- Mes/Año -->
            <Label x:Name="LblMesAnio"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#1F2937"
                   HorizontalOptions="Center"
                   Margin="0,0,0,8"/>

            <!-- Contenedor de los días -->
            <Grid x:Name="DiasGrid"
                  Grid.Row="1"
                  RowSpacing="6"
                  ColumnSpacing="6"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"/>
        </Grid>
    </Border>
</ContentView>
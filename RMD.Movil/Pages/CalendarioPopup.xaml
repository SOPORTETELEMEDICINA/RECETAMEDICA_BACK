<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RMD.Movil.Pages.CalendarioPopup"
    BackgroundColor="#80000000"
    IsVisible="False">

    <Grid HorizontalOptions="Center" VerticalOptions="Center">
        <Border
            Padding="20"
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            WidthRequest="320">
            <Border.Shadow>
                <Shadow Opacity="0.35" Offset="0,6" Radius="18" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="15">

                <!-- Encabezado mes y botones navegación -->
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                    <Button Text="&lt;"
                            BackgroundColor="Transparent"
                            FontSize="20"
                            Clicked="BtnAnterior_Clicked" />
                    <Label x:Name="LblMesAnio"
                           Grid.Column="1"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="#3A3A3A" />
                    <Button Text=">"
                            Grid.Column="2"
                            BackgroundColor="Transparent"
                            FontSize="20"
                            Clicked="BtnSiguiente_Clicked" />
                </Grid>

                <!-- Calendario -->
                <Grid x:Name="DiasGrid"
                      RowSpacing="10"
                      ColumnSpacing="10"
                      HorizontalOptions="Center"
                      VerticalOptions="Center">
                    <!-- Columnas para 7 días -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 7 filas (1 encabezado + hasta 6 semanas) -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                </Grid>

                <!-- Botón cancelar -->
                <Button Text="Cancelar"
                        BackgroundColor="#6f61ee"
                        TextColor="White"
                        CornerRadius="20"
                        HeightRequest="45"
                        Clicked="BtnCancelar_Clicked" />

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>

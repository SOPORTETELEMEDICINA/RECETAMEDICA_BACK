<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:RMD.Movil.PageModels"
             x:Class="RMD.Movil.Pages.RegistrarEventoSaludPage"
             x:DataType="pageModels:RegistrarEventoSaludPageModel"
             Title="Nuevo Evento de Salud"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Imagen de fondo -->
        <Image Source="Shared/fondo_plantilla.png"
               Aspect="AspectFill"
               Opacity="1"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <!-- Contenido -->
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20"
                         VerticalOptions="Start"
                         Margin="0,80,0,0">

                <!-- Card de formulario -->
                <Border BackgroundColor="White"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                Padding="20"
                Margin="0"
                HorizontalOptions="Fill">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="2,2" Radius="6" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <Label Text="Tipo de Evento"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="Black" />

                        <Picker ItemsSource="{Binding TiposEventos}"
                        ItemDisplayBinding="{Binding NombreEvento}"
                        SelectedItem="{Binding TipoSeleccionado}">
                            <Picker.Title>Selecciona un evento</Picker.Title>
                        </Picker>

                        <Label Text="Fecha del Evento"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="Black" />

                        <DatePicker Date="{Binding FechaEvento}" />

                        <Label Text="Descripción"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="Black" />

                        <Editor Text="{Binding Descripcion}"
                        HeightRequest="120"
                        Placeholder="Describe brevemente el evento" />

                        <!-- Botones -->
                        <Grid ColumnDefinitions="*,*"
                      HorizontalOptions="Fill"
                      ColumnSpacing="20"
                      Margin="0,10,0,0">

                            <Button Text="Cancelar"
                            Grid.Column="1"
                            BackgroundColor="OrangeRed"
                            TextColor="White"
                            Command="{Binding CancelarCommand}"
                            CornerRadius="12"
                            HeightRequest="50" />

                            <Button Text="Guardar"
                            Grid.Column="0"
                            BackgroundColor="#6F61EE"
                            TextColor="White"
                            Command="{Binding GuardarCommand}"
                            CornerRadius="12"
                            HeightRequest="50" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>

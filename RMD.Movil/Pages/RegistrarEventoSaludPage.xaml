<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RMD.Movil.Pages.RegistrarEventoSaludPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pageModels="clr-namespace:RMD.Movil.PageModels"
    x:DataType="pageModels:RegistrarEventoSaludPageModel"
    NavigationPage.HasNavigationBar="False"
    Title="Nuevo Evento de Salud"
    BackgroundImageSource="fondo_pantalla.png">

    <!-- AppBar (Auto) + Contenido (*) -->
    <Grid RowDefinitions="Auto,*">

        <!-- AppBar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="8,50,8,0">
            <Button
                Text="&#xE5CB;"
                FontFamily="MaterialIcons"
                BackgroundColor="Transparent"
                TextColor="#111827"
                FontSize="28"
                WidthRequest="48" HeightRequest="48"
                Command="{Binding BackCommand}" />
            <Label Grid.Column="1"
                   VerticalTextAlignment="Center"
                   FontSize="22"
                   FontAttributes="Bold"
                   Text="Nuevo Evento de Salud"
                   TextColor="#111827" />
        </Grid>

        <!-- Contenido -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20"
                                 VerticalOptions="Start"
                                 Margin="0,12,0,24">

                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="20"
                        Margin="0"
                        HorizontalOptions="Fill">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="2,2" Radius="6" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <!-- Tipo de evento -->
                        <Label Text="Tipo de Evento"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="Black" />

                        <Picker ItemsSource="{Binding TiposEventos}"
                                ItemDisplayBinding="{Binding NombreEvento}"
                                SelectedItem="{Binding TipoSeleccionado}">
                            <Picker.Title>Selecciona un evento</Picker.Title>
                        </Picker>

                        <!-- Medicamentos activos -->
                        <Picker ItemsSource="{Binding MedicamentosActivos}"
                                ItemDisplayBinding="{Binding Medicamento}"
                                SelectedItem="{Binding MedicamentoSeleccionado}"
                                IsVisible="{Binding MostrarMedicamentos}">
                            <Picker.Title>Selecciona un medicamento</Picker.Title>
                        </Picker>

                        <!-- Fecha -->
                        <Label Text="Fecha del Evento"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="Black"
                               IsVisible="{Binding MostrarCampos}" />
                        <DatePicker Date="{Binding FechaEvento}"
                                    IsVisible="{Binding MostrarCampos}" />

                        <!-- Descripción -->
                        <Label Text="Descripción"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="Black"
                               IsVisible="{Binding MostrarCampos}" />
                        <Editor Text="{Binding Descripcion}"
                                HeightRequest="120"
                                Placeholder="Describe brevemente el evento"
                                IsVisible="{Binding MostrarCampos}" />

                        <!-- Botones -->
                        <Grid ColumnDefinitions="*,*"
                              HorizontalOptions="Fill"
                              ColumnSpacing="20"
                              Margin="0,10,0,0"
                              IsVisible="{Binding MostrarCampos}">

                            <Button Text="Cancelar"
                                    Grid.Column="1"
                                    BackgroundColor="OrangeRed"
                                    TextColor="White"
                                    Command="{Binding CancelarCommand}"
                                    CornerRadius="12"
                                    HeightRequest="50" />

                            <Button Text="Guardar"
                                    Grid.Column="0"
                                    BackgroundColor="#6F61EE"
                                    TextColor="White"
                                    Command="{Binding GuardarCommand}"
                                    CornerRadius="12"
                                    HeightRequest="50" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

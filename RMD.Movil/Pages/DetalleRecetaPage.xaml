<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RMD.Movil.Pages.DetalleRecetaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:RMD.Movil.PageModels"
    x:Name="Page"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="Transparent"
    BackgroundImageSource="fondo_pantalla.png">

    <Grid RowDefinitions="Auto,*" Padding="20">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="8,50,8,0">
            <Button Text="&#xE5CB;" FontFamily="MaterialIcons"
                    BackgroundColor="Transparent" TextColor="#111827"
                    FontSize="28" WidthRequest="48" HeightRequest="48"
                    Command="{Binding BackCommand}" />
            <Label Grid.Column="1" VerticalTextAlignment="Center"
                   FontSize="22" FontAttributes="Bold"
                   Text="Detalle de Receta" TextColor="#111827" />
        </Grid>

        <!-- Card contenedor -->
        <Border Grid.Row="1" Margin="0,5,0,0" Padding="0"
                BackgroundColor="White" Stroke="#E0E3EB" StrokeThickness="1"
                StrokeShape="RoundRectangle 18">
            <Border.Shadow>
                <Shadow Brush="#33000000" Radius="12" Offset="0,4" Opacity="0.25"/>
            </Border.Shadow>

            <!-- Lista -->
            <CollectionView
                ItemsSource="{Binding DetallesUI}"
                SelectionMode="None"
                ItemSizingStrategy="MeasureAllItems"
                BackgroundColor="Transparent">

                <CollectionView.EmptyView>
                    <Grid Padding="20">
                        <Label Text="No se ha surtido ningún medicamento de esta receta"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="#69728b"/>
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetalleItemUI">
                        <Grid>

                            <Border x:Name="ItemRoot"
                    Margin="0,5" Padding="14"
                    BackgroundColor="{Binding CardBackgroundColor}"
                    Stroke="{Binding CardStrokeColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    IsEnabled="{Binding ItemIsEnabled}">

                                <Border.Shadow>
                                    <Shadow Brush="#1A000000" Radius="8" Offset="0,2" Opacity="0.20"/>
                                </Border.Shadow>

                                <!-- SIN TouchBehavior para evitar TaskCanceledException -->

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                        NumberOfTapsRequired="1"
                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.ActivarAlertaCommand}"
                        CommandParameter="{Binding Source={x:Reference ItemRoot}, Path=BindingContext}" />
                                </Border.GestureRecognizers>

                                <!-- Tu layout interno -->
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">

                                    <Label Grid.Row="0" Grid.ColumnSpan="2"
                           Text="{Binding MedicamentoNombre}"
                           FontAttributes="Bold"
                           TextColor="#3A3A3A"
                           FontSize="15"/>

                                    <HorizontalStackLayout Grid.Row="1" Spacing="6">
                                        <Label Text="Surtido:" FontSize="12" TextColor="#69728b"/>
                                        <Label Text="{Binding CantidadSurtida}" FontSize="12" TextColor="#9d69ca" FontAttributes="Bold"/>
                                        <Label Text="{Binding UnidadDispensacion}" FontSize="12" TextColor="#9d69ca" FontAttributes="Bold"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Row="2" Spacing="6">
                                        <Label Text="Dosis:" FontSize="12" TextColor="#69728b"/>
                                        <Label Text="{Binding CantidadDiaria}" FontSize="12" TextColor="#3A3A3A"/>
                                        <Label Text="Frecuencia:" FontSize="12" TextColor="#69728b" Margin="14,0,0,0"/>
                                        <Label Text="{Binding Frecuency}" FontSize="12" TextColor="#3A3A3A"/>
                                        <Label Text="{Binding FrecuencyType}" FontSize="12" TextColor="#3A3A3A"/>
                                    </HorizontalStackLayout>

                                    <Grid Grid.Row="3">
                                        <Label Text="Indicaciones:" FontSize="12" TextColor="#69728b"/>
                                        <Label Text="{Binding Indicacion}" FontSize="12" TextColor="#3A3A3A" Margin="90,0,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Badge -->
                            <Border IsVisible="{Binding MostrarBadge}"
                    BackgroundColor="{Binding BadgeBgColor}"
                    Padding="6,2"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    Margin="0,10,10,0"
                    InputTransparent="True">
                                <Label Text="Alerta activa" FontSize="11" TextColor="White"/>
                            </Border>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>


            </CollectionView>
        </Border>

        <!-- Overlay -->
        <Grid Grid.RowSpan="2" BackgroundColor="#80000000" IsVisible="{Binding IsBusy}">
            <ActivityIndicator HorizontalOptions="Center" VerticalOptions="Center"
                               IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </Grid>
    </Grid>
</ContentPage>

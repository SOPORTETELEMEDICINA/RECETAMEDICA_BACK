<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RMD.Movil.Views.RecetasPage"
             BackgroundColor="#F7F9FC"
             Title="Mis Recetas">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Header con nombre -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" Padding="0,10">
                <Label Text="Eva Zaragoza" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                <Frame HeightRequest="45" WidthRequest="45" CornerRadius="22.5" HasShadow="False" Padding="0" BackgroundColor="Transparent">
                    <Image Source="avatar_sample.png" Aspect="AspectFill"/>
                </Frame>
            </Grid>

            <Label Text="Buen día!!!" FontSize="14" TextColor="Gray"/>

            <!-- Botones principales -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Frame BackgroundColor="#00B0C0" CornerRadius="10" Padding="15" HeightRequest="80">
                    <VerticalStackLayout>
                        <Label Text="Registrar Receta" FontAttributes="Bold" FontSize="14" TextColor="White"/>
                        <Label Text="EXTERNA" FontSize="12" TextColor="White"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="#F06251" CornerRadius="10" Padding="15" HeightRequest="80">
                    <VerticalStackLayout>
                        <Label Text="Toma de Medicamentos" FontAttributes="Bold" FontSize="14" TextColor="White"/>
                        <Label Text="REGISTRO NUEVO" FontSize="12" TextColor="White"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Sección de pestañas -->
            <Label Text="Mis Recetas" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0"/>

            <Grid ColumnDefinitions="*,*" Padding="0,0,0,10">
                <Button x:Name="btnActivas" Text="Activas" BackgroundColor="Transparent" TextColor="#7B4DF9" FontAttributes="Bold" Clicked="btnActivas_Clicked"/>
                <Button x:Name="btnVencidas" Text="Vencidas" BackgroundColor="Transparent" TextColor="Gray" Grid.Column="1" Clicked="btnVencidas_Clicked"/>
            </Grid>

            <!-- Tarjetas de receta -->
            <CollectionView x:Name="RecetasCollection" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="10" Padding="15" Margin="0,0,0,10" BackgroundColor="White" HasShadow="True">
                            <VerticalStackLayout>
                                <Label Text="{Binding Folio}" FontSize="14" FontAttributes="Bold"/>
                                <Label Text="{Binding Doctor}" FontSize="13" TextColor="Gray"/>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0">
                                    <Label Text="Fecha:" FontSize="12" TextColor="Black"/>
                                    <Label Text="{Binding Fecha}" FontSize="12" TextColor="Black" Margin="10,0,0,0"/>
                                </Grid>
                                <Frame BackgroundColor="{Binding Color}" CornerRadius="10" Padding="5" HorizontalOptions="Start">
                                    <Label Text="{Binding Estado}" FontSize="12" TextColor="White"/>
                                </Frame>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

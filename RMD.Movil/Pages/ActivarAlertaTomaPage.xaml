<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RMD.Movil.Pages.ActivarAlertaTomaPage"
    NavigationPage.HasNavigationBar="False"
    Shell.PresentationMode="ModalAnimated"
    BackgroundColor="#80000000">

    <!-- Modal centrado -->
    <Grid Padding="24" RowDefinitions="*,Auto,*">
        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E0E3EB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                Padding="20">
            <VerticalStackLayout Spacing="16">

                <Label Text="Activar alerta de toma"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#3A3A3A"
                       HorizontalOptions="Center"/>

                <Label Text="Indica la fecha y hora de la última dosis"
                       FontSize="14"
                       TextColor="#69728b"
                       HorizontalOptions="Center"/>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">
                    <VerticalStackLayout>
                        <Label Text="Fecha" FontSize="12" TextColor="#69728b"/>
                        <DatePicker Date="{Binding FechaSeleccionada}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Hora" FontSize="12" TextColor="#69728b"/>
                        <TimePicker Time="{Binding HoraSeleccionada}" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <Border Background="#E0E3EB" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelarCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Cancelar"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="#3A3A3A"
                               Padding="0,10"/>
                    </Border>

                    <Border Grid.Column="1" Background="#00a5b8" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AceptarCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Activar"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="White"
                               Padding="0,10"/>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

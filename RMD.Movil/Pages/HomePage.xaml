<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RMD.Movil.Pages.HomePage"
    xmlns:pageModels="clr-namespace:RMD.Movil.PageModels"
    x:DataType="pageModels:HomePageModel"
    BackgroundColor="Transparent"
    NavigationPage.HasNavigationBar="False"
    BackgroundImageSource="fondo_pantalla.png">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0"
              ColumnDefinitions="0.55*,0.45*"
              RowDefinitions="Auto,Auto"
              HeightRequest="250"
              VerticalOptions="Start">

            <Image Grid.Column="0"
                   Grid.RowSpan="2"
                   Source="med_login.png"
                   Aspect="AspectFill"
                   VerticalOptions="Fill"
                   HorizontalOptions="Start"
                   HeightRequest="250" />

            <Image Grid.Column="1"
                   Grid.Row="0"
                   Source="logo_login.png"
                   Aspect="AspectFit"
                   HeightRequest="150"
                   HorizontalOptions="Start"
                   VerticalOptions="EndAndExpand"
                   Margin="0,5,0,0" />

            <Label Grid.Column="1"
                   Grid.Row="1"
                   Text="¿Qué deseas hacer el día de hoy?"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="EndAndExpand"
                   TextColor="#3A3A3A"
                   HorizontalOptions="Start"
                   Margin="0,5,0,0" />
        </Grid>

        <!-- OPCIONES -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,*"
              Padding="0"
              RowSpacing="20"
              ColumnSpacing="20"
              VerticalOptions="Center"
              Margin="0,-5,0,0">

            <!-- Ver mis Recetas -->
            <Border Grid.Row="0" Grid.Column="0"
                    Stroke="Transparent"
                    Background="White"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding VerRecetasCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                    <Image Source="icon_recetas.png" HeightRequest="50" />
                    <Label Text="Ver mis Recetas"
                           FontSize="14"
                           TextColor="#3A3A3A"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Registrar evento de salud -->
            <Border Grid.Row="0" Grid.Column="1"
                    Stroke="Transparent"
                    Background="White"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EventoSaludCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                    <Image Source="icon_evento_salud.png" HeightRequest="50" />
                    <Label Text="Registrar Evento de Salud"
                           FontSize="14"
                           TextColor="#3A3A3A"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           WidthRequest="100" />
                </VerticalStackLayout>
            </Border>

            <!-- Avisos de medicación -->
            <Border Grid.Row="1" Grid.Column="0"
                    Stroke="Transparent"
                    Background="White"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding MedicacionCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                    <Image Source="icon_avisos.png" HeightRequest="50" />
                    <Label Text="Avisos de medicación"
                           FontSize="14"
                           TextColor="#3A3A3A"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           WidthRequest="100" />
                </VerticalStackLayout>
            </Border>

            <!-- Mi perfil de salud -->
            <Border Grid.Row="1" Grid.Column="1"
                    Stroke="Transparent"
                    Background="White"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PerfilSaludCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                    <Image Source="icon_perfil.png" HeightRequest="50" />
                    <Label Text="Mi perfil de salud"
                           FontSize="14"
                           TextColor="#3A3A3A"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- BOTÓN CERRAR SESIÓN -->
        <Border Grid.Row="2"
                Stroke="Transparent"
                Background="#00a5b8"
                StrokeShape="RoundRectangle 30"
                Padding="0"
                HeightRequest="50"
                WidthRequest="250"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,20,0,10">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CerrarSesionCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*,Auto"
                  VerticalOptions="Center"
                  HorizontalOptions="Center"
                  Padding="5">

                <Image Source="icono_cerrar_uno.png"
                       HeightRequest="40"
                       VerticalOptions="Center"
                       Margin="15,0,15,0" />

                <Label Grid.Column="1"
                       Text="Cerrar sesión"
                       TextColor="White"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <Image Grid.Column="2"
                       Source="icono_cerrar_dos.png"
                       HeightRequest="30"
                       VerticalOptions="Center"
                       Margin="15,0,15,0" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>




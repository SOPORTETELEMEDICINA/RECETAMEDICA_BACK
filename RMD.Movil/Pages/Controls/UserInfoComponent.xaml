<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:RMD.Movil.PageModels.Controls"
             x:Class="RMD.Movil.Pages.Controls.UserInfoComponent"
             x:DataType="pageModels:UserInfoComponentModel">

    <!-- Grid principal: 2 columnas (50% - 50%) -->
    <Grid ColumnDefinitions="0.5*, 0.5*"
          Padding="20,20,20,0"
          HeightRequest="80">

        <!-- Grid derecha: 2 filas, 2 columnas -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,Auto">

            <!-- NombreUsuario (fila 0, columna 0) -->
            <Label Grid.Row="0" Grid.Column="0"
                   Text="{Binding NombreUsuario}"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="Black"
                   VerticalOptions="End" />

            <!-- Buen día!!! (fila 1, columna 0) -->
            <Label Grid.Row="1" Grid.Column="0"
                   Text="Buen día!!!"
                   FontSize="12"
                   TextColor="Gray"
                   VerticalOptions="Start" />

            <!-- Imagen (columna 1, que abarca ambas filas) -->
            <Border Grid.Row="0" Grid.Column="1"
                    Grid.RowSpan="2"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="Transparent"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <Ellipse />
                </Border.StrokeShape>
                <Image Source="{Binding ImagenUsuarioBase64}"
                       WidthRequest="40"
                       HeightRequest="40"
                       Aspect="AspectFill" />
            </Border>
        </Grid>

    </Grid>
</ContentView>

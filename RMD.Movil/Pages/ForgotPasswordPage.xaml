<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RMD.Movil.Pages.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RMD.Movil.PageModels"
    x:DataType="vm:ForgotPasswordPageModel"
    NavigationPage.HasNavigationBar="False"
    BackgroundImageSource="fondo_pantalla.png"
    BackgroundColor="#FFFFFF">

    <Grid>
        <ScrollView>
            <!-- Bajamos todo para que respete el fondo -->
            <Grid Margin="0,80,0,24" RowDefinitions="Auto,Auto">

                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="0,12,16,0">
                    <Button
                        Text="&#xE5CB;"
                        FontFamily="MaterialIcons"
                        BackgroundColor="Transparent"
                        TextColor="#374151"
                        FontSize="30"
                        WidthRequest="60" HeightRequest="48"
                        Command="{Binding BackCommand}" />
                    <Label Grid.Column="1"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Start"
                           Text="Olvide mi contraseña..."
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#47c7f1" />
                </Grid>

                <!-- Zona central con 3 columnas: *, Auto, * para centrar -->
                <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="*,Auto,*" Padding="16,0">

                    <!-- Card centrada llenando todo el ancho -->
                    <ContentView Grid.ColumnSpan="3"
                                 HorizontalOptions="FillAndExpand">

                        <Border
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0"
                            Padding="16">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.12" Radius="8" Offset="0,4"/>
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="20" Padding="0,8,0,0">

                                <Label
                                    Text="No recuerdas tu contraseña, no te preocupes. Ingresa el correo con el que te registraste y te enviaremos los nuevos datos de ingreso."
                                    TextColor="#4B5563"
                                    FontSize="14"
                                    LineBreakMode="WordWrap" />

                                <!-- Campo correo -->
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Correo Electrónico"
                                           FontSize="14"
                                           TextColor="#374151" />

                                    <Border Stroke="#E5E7EB"
                                            StrokeThickness="2"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="#FFFFFF">
                                        <Grid Padding="5,0">
                                            <Entry
                                                Text="{Binding Email}"
                                                Placeholder="Ingresa tu correo electrónico de registro"
                                                Keyboard="Email"
                                                TextColor="#111827"
                                                PlaceholderColor="#9CA3AF"
                                                ReturnType="Done" />
                                        </Grid>
                                    </Border>

                                    <Label Text="{Binding EmailError}"
                                           IsVisible="{Binding HasEmailError}"
                                           TextColor="#EF4444"
                                           FontSize="12" />
                                </VerticalStackLayout>

                                <!-- Botón -->
                                <Grid Padding="0,8,0,0" HorizontalOptions="Center">
                                    <Button
                                        Text="Enviar Link de recuperación"
                                        Command="{Binding SendCommand}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        WidthRequest="230"
                                        HeightRequest="50"
                                        CornerRadius="25"
                                        TextColor="White"
                                        BackgroundColor="#6F61EE">
                                        <Button.Shadow>
                                            <Shadow Brush="Black" Opacity="0.25" Radius="8" Offset="0,6"/>
                                        </Button.Shadow>
                                    </Button>
                                </Grid>

                                <!-- Loader -->
                                <ActivityIndicator
                                    IsRunning="{Binding IsBusy}"
                                    IsVisible="{Binding IsBusy}"
                                    Color="#6F61EE"
                                    HorizontalOptions="Center" />

                            </VerticalStackLayout>
                        </Border>
                    </ContentView>
                </Grid>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>

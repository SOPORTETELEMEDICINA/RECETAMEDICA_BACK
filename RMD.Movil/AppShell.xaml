<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:RMD.Movil.Pages"
    x:Class="RMD.Movil.AppShell"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent Route="RegionPage" ContentTemplate="{DataTemplate pages:RegionPage}" />
    <ShellContent Route="LoginPage" ContentTemplate="{DataTemplate pages:LoginPage}" />
    <ShellContent Route="HomePage" ContentTemplate="{DataTemplate pages:HomePage}" />
    <ShellContent Route="EventosPage" ContentTemplate="{DataTemplate pages:EventosPage}" />
    <ShellContent Route="RegistrarEventoSaludPage" ContentTemplate="{DataTemplate pages:RegistrarEventoSaludPage}" />
</Shell>